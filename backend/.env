# 环境变量配置文件（开发环境）
# 数据库
DB_NAME=campus_resource
DB_USER=root
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=3306

# Django
SECRET_KEY=dev-secret-key-change-me-in-production-abc123
DEBUG=True
ALLOWED_HOSTS=*

# CORS
CORS_ORIGINS=http://localhost:5173

# 阿里云 OSS（部署时填写）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=

# DeepSeek API（部署时填写）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
